{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xlx0852/model-catalog/schema.json",
  "title": "sub2api model catalog",
  "type": "object",
  "required": ["version", "platforms", "fallback_pricing", "image_defaults", "ui_presets"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {"id": {"type": "string", "minLength": 1}}
            }
          },
          "aliases": {"type": "object", "additionalProperties": {"type": "string"}},
          "retired_ids": {"type": "array", "items": {"type": "string"}},
          "default_mapping": {"type": "object", "additionalProperties": {"type": "string"}}
        }
      }
    },
    "fallback_pricing": {"type": "object"},
    "image_defaults": {"type": "object"},
    "ui_presets": {"type": "object"}
  }
}
